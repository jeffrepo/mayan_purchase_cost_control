<odoo>
    <record id="res_config_settings_view_form_purchase_cost_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.cost.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="mayan_purchase_cost_control" string="Variación de costo permitida (%)"
                         company_dependent="1"
                         help="Se exige justificación cuando la variación supera este porcentaje, en aumento o disminución. Los límites están incluidos; 0 exige justificar cualquier variación.">
                    <field name="mayan_purchase_cost_tolerance" class="oe_inline"/>
                    <span class="ms-1">%</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
